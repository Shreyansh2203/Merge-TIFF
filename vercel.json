{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/merge.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,.pytest_cache/**,.venv/**,venv/**,**/__pycache__/**,*.pyc}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/merge" },
    { "source": "/health", "destination": "/api/merge" }
  ]
}
