{
  "name": "tiff-merger-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --import tsx --test \"tests/js/*.test.mjs\" \"tests/js/*.test.tsx\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"next.config.mjs\" --test-coverage-include=\"src/lib/**\" --test-coverage-include=\"src/app/page.tsx\" --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100 \"tests/js/*.test.mjs\" \"tests/js/*.test.tsx\""
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "@playwright/test": "^1.53.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
